<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/bg_down"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/dp_0"
    android:clipToPadding="true"
    tools:context=".ui.my_creation.fragment.MyDesignFragment">

    <!--    rcvMyDesign-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvMyDesign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_16"
        android:clipChildren="false"
        android:layout_marginTop="@dimen/dp_0"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:listitem="@layout/item_my_design" />

    <!-- No Item-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNoItem"
        android:layout_width="@dimen/_220dp"
        android:layout_height="@dimen/dp_200"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_50"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">

        <ImageView
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:src="@drawable/img_no_item" />

        <TextView
            android:id="@+id/tvNoitem"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo_2_bold"
            android:gravity="center"
            android:text="@string/no_item_here"
            android:textColor="#8E5037"
            android:textSize="@dimen/sp_14"
            android:layout_marginHorizontal="@dimen/dp_15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias=".95"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:translationY="@dimen/dp_0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>