<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            app:cardBackgroundColor="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="@dimen/dp_0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="@dimen/dp_328"
                android:layout_height="@dimen/dp_180"
                android:background="@drawable/bg_dialog_delete_exit">

                <!--  tvTitle (Top) -->
                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_50"
                    android:layout_marginTop="@dimen/dp_10"
                    android:fontFamily="@font/baloo_2_bold"
                    android:gravity="center"
                    android:paddingVertical="@dimen/dp_5"
                    android:paddingHorizontal="@dimen/dp_30"
                    tools:text="aaaaaaaaaaaaaaaaaaaaaaaaa"
                    android:text="@string/loading"
                    android:layout_marginBottom="@dimen/dp_minus_25"
                    android:elevation="@dimen/dp_1"
                    android:textColor="@color/figma_primary"
                    android:textSize="@dimen/sp_24"
                app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"

                    />


                <!-- ivSpinner (Center) -->
                <ImageView
                    android:id="@+id/ivSpinner"
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:src="@drawable/ic_loading_dialog"
                    android:tint="@color/figma_primary"
                    app:layout_constraintBottom_toTopOf="@id/tvDescription"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <!--  tvDescription (Bottom) -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo2_semibold"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:paddingHorizontal="@dimen/dp_24"
                    android:text="@string/wait_a_minute"
                    android:textColor="#999999"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
