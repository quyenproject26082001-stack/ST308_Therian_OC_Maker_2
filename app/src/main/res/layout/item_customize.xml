<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_1_5"
    app:layout_constraintDimensionRatio="1:1">


    <!--        vFocus-->
    <View
        android:id="@+id/vFocus"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/cardLayerItem"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_margin="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@drawable/layer_slt">

        <!--                    imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:padding="@dimen/dp_5"
            android:scaleType="fitCenter"
            android:src="@color/red_BA" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.7"
            app:shimmer_direction="left_to_right"
            app:shimmer_duration="1800"
            app:shimmer_highlight_alpha="0.6"
            app:shimmer_shape="linear">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_8_gray" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!--            btnNone-->
        <ImageView
            android:id="@+id/btnNone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_15"

            android:scaleType="fitXY"
            android:src="@drawable/ic_none"
            android:translationY="@dimen/dp_minus_2"
            android:visibility="gone" />

        <!--            btnRandom-->
        <ImageView
            android:id="@+id/btnRandom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dp_15"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_random_layer"
            android:tint="@color/figma_primary"
            android:translationY="@dimen/dp_minus_2"
            android:visibility="gone" />


    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>