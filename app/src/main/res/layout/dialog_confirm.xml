<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">



        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="328dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dialog_delete_exit"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">



                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="50dp"
                    android:layout_marginBottom="-26dp"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:elevation="1dp"
                    android:fontFamily="@font/baloo_2_bold"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:text="@string/delete"
                    tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                    android:textColor="@color/figma_primary"
                    android:textSize="24sp"

                    />

                <!--            tvDescription-->
                <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:fontFamily="@font/baloo2_semibold"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/do_you_want_to_exit"
                    android:textColor="#999999"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                />

                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <!--                    btnNo-->
                    <TextView
                        android:id="@+id/btnYes"
                        android:layout_width="88dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/ic_yes_dialog"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/yes"
                        android:textColor="@color/app"
                        android:textSize="18sp" />
                    <!--                    btnYes-->
                    <TextView
                        android:id="@+id/btnNo"
                        android:layout_width="88dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/ic_no_dialog"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/no"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
