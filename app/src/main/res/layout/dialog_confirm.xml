<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">



        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/dp_8"
            app:cardElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="@dimen/dp_328"
                android:layout_height="@dimen/dp_200"
                android:layout_gravity="center"
                android:background="@drawable/bg_dialog_delete_exit"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">



                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginHorizontal="@dimen/dp_50"
                    android:layout_marginBottom="@dimen/dp_minus_26"
                    android:clipChildren="false"
                    android:clipToOutline="false"
                    android:clipToPadding="false"
                    android:elevation="@dimen/dp_1"
                    android:fontFamily="@font/baloo_2_bold"
                    android:gravity="center"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/delete"
                    tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                    android:textColor="@color/figma_primary"
                    android:textSize="@dimen/sp_24"

                    />

                <!--            tvDescription-->
                <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_64"
                    android:fontFamily="@font/baloo2_semibold"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_24"
                    android:text="@string/do_you_want_to_exit"
                    android:textColor="#999999"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                />

                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <!--                    btnNo-->
                    <TextView
                        android:id="@+id/btnYes"
                        android:layout_width="@dimen/dp_88"
                        android:layout_height="@dimen/dp_44"
                        android:layout_weight="1"
                        android:background="@drawable/ic_yes_dialog"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:paddingVertical="@dimen/dp_6"
                        android:text="@string/yes"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_18" />
                    <!--                    btnYes-->
                    <TextView
                        android:id="@+id/btnNo"
                        android:layout_width="@dimen/dp_88"
                        android:layout_height="@dimen/dp_44"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_weight="1"
                        android:background="@drawable/ic_no_dialog"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:paddingVertical="@dimen/dp_9"
                        android:text="@string/no"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_18" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="@dimen/dp_42"
                android:layout_height="@dimen/dp_42"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
