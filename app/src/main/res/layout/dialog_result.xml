<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgLight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_height="50dp"
            tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        android:paddingHorizontal="30dp"
            android:layout_marginHorizontal="51dp"
            android:layout_marginBottom="-26dp"
            android:background="@drawable/bg_title"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            android:elevation="1dp"
            android:fontFamily="@font/baloo_2_bold"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/cosplay_results"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@id/layoutMain"
            app:layout_constraintEnd_toEndOf="@id/layoutMain"
            app:layout_constraintStart_toStartOf="@id/layoutMain" />

        <!--        layoutMain-->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDialog"
                android:layout_width="328dp"
                android:layout_height="338dp"
                android:background="@drawable/bg_dialog_delete_exit"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:clipToPadding="false">


                <!--            tvDescription-->
                <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:fontFamily="@font/baloo_2_bold"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/your_cosplay_score"
                    android:textColor="#586B8C"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <FrameLayout
                    android:id="@+id/ctnImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/bg_img_character_sample"
                    android:visibility="visible"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toStartOf="@id/ctnSample"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription"
                    app:layout_constraintVertical_bias="0">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="3dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="#586B8C"
                        app:cardCornerRadius="7dp"
                        app:layout_constraintDimensionRatio="156:152"
                        app:strokeColor="@color/transparent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            app:cardBackgroundColor="@color/app1"
                            app:cardCornerRadius="7dp"
                            app:strokeColor="@color/transparent">

                            <ImageView
                                android:id="@+id/btnImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="0dp"
                                android:scaleType="fitCenter" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>


                <FrameLayout
                    android:id="@+id/ctnSample"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/bg_img_character_sample"
                    android:visibility="visible"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ctnImage"
                    app:layout_constraintTop_toTopOf="@id/ctnImage"
                    app:layout_constraintVertical_bias="0">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="3dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="#586B8C"
                        app:cardCornerRadius="7dp"
                        app:layout_constraintDimensionRatio="156:152"
                        app:strokeColor="@color/transparent">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            app:cardBackgroundColor="@color/app1"
                            app:cardCornerRadius="7dp"
                            app:strokeColor="@color/transparent">

                            <ImageView
                                android:id="@+id/btnSamplePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="0dp"
                                android:scaleType="fitCenter" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:strokeColor="@color/app"
                        app:strokeWidth="2dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:cardBackgroundColor="#E8EDF7">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_100_match"
                        android:textSize="16sp"
                        android:paddingHorizontal="10dp"
                        android:id="@+id/tvRef"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:fontFamily="@font/baloo_2_bold"
                        android:textColor="@color/app"
                        tools:text="qqqqqqqqqqqq"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />
                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>
                
                
                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="33dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="156:40"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">


                    <!--                    btnYes-->
                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="88dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/ic_no_dialog"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/spin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_loading"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
