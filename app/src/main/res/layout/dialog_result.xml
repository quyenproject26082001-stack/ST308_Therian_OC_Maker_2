<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgLight"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!--        layoutMain-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMain"
            android:layout_width="@dimen/dp_328"
            android:layout_height="@dimen/dp_365"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="#EDEDFF"
            app:cardElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
          >


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#EDEDFF"
                app:cardCornerRadius="@dimen/dp_16"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_1"/>

            <TextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:clipChildren="false"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_30"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/cosplay_results"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_24"
                tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ctnImg"
                android:layout_width="@dimen/dp_184"
                android:layout_height="@dimen/dp_184"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/dp_3"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/dp_76"
                app:cardCornerRadius="@dimen/dp_12"
                app:layout_constraintDimensionRatio="156:152"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">


                <ImageView
                    android:id="@+id/btnImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/dp_0"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_3"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/dp_7"
                app:strokeColor="@color/transparent">

                <ImageView
                    android:id="@+id/btnSamplePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/dp_0"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="@dimen/dp_260"
                android:layout_height="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@id/ctnImg"
                android:background="@drawable/bg_progress_empty_h"
                app:layout_constraintBottom_toTopOf="@id/tvRef"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/ctnProgress"
                >
                <ImageView
                    android:id="@+id/sbProgressFull"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_progress_full_h"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_thumb"
                app:layout_constraintTop_toTopOf="@id/ctnProgress"
                app:layout_constraintBottom_toBottomOf="@id/ctnProgress"
                app:layout_constraintStart_toStartOf="@id/ctnProgress"
                android:id="@+id/icThumb"
                />


            <TextView
                android:id="@+id/tvRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_10"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_20"
                app:layout_constraintTop_toBottomOf="@id/ctnProgress"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/dp_20"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="100%" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llButtons"
            android:layout_width="@dimen/dp_156"
            android:layout_height="@dimen/dp_44"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_33"
            app:strokeWidth="@dimen/dp_2"
            app:strokeColor="@color/figma_primary"
            app:cardBackgroundColor="@color/white"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_28"
            app:layout_constraintTop_toBottomOf="@id/layoutMain"
            app:layout_constraintDimensionRatio="156:44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">


            <!--                    btnYes-->
            <TextView
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/baloo_2_bold"
                android:gravity="center"
                android:paddingVertical="@dimen/dp_9"
                android:text="@string/next"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_16" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/spin"
            android:layout_width="@dimen/dp_42"
            android:layout_height="@dimen/dp_42"
            android:layout_gravity="center"
            android:src="@drawable/ic_loading"
            android:visibility="gone" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
