<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">





        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/bg_dialog_rate"
            >


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_51"
                android:layout_marginTop="@dimen/dp_16"
                android:elevation="@dimen/dp_1"
                android:layout_marginBottom="@dimen/dp_minus_22"
              app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                >
                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/baloo_2_bold"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/dp_3"
                    android:layout_marginHorizontal="@dimen/dp_30"
                    android:text="@string/choose_color"
                    android:textColor="@color/figma_primary"
                    android:textSize="@dimen/sp_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:tint="#FFFFFF"
                    android:visibility="invisible"
                    android:src="@drawable/ic_close_color_pick"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_160"
                android:layout_marginHorizontal="@dimen/dp_34"
                android:layout_marginTop="@dimen/dp_60"
                app:sliderStrokeSize="@dimen/dp_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_0"
                android:layout_marginBottom="@dimen/dp_20"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView"
                app:layout_constraintBottom_toBottomOf="parent">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderStrokeSize="@dimen/dp_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="@dimen/dp_0"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="@dimen/dp_34" />


                <!--                btnDone-->
                <RelativeLayout
                    android:id="@+id/btnDone"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_44"
                    android:layout_gravity="end"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_15"
                    android:background="@drawable/ic_no_dialog"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnClose"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnDoneText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:text="@string/done"
                        style="@style/single_marquee"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_18" />
                </RelativeLayout>
                <!--                btnDone-->
                <RelativeLayout
                    android:id="@+id/btnClose"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/dp_15"
                    android:background="@drawable/ic_yes_dialog"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    app:layout_constraintTop_toBottomOf="@id/hueSlider"
                    >
                    <TextView
                        android:id="@+id/btnCancelText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:text="@string/cancel"
                        style="@style/single_marquee"
                        android:textColor="@color/app"
                        android:textSize="@dimen/sp_18" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/btnStringColor"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_40"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/dp_6"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnDone"
                    app:layout_constraintBottom_toBottomOf="@id/btnDone"
                    app:layout_constraintEnd_toStartOf="@id/btnDone"
                    android:background="@drawable/bg_string_color">

                    <TextView
                        android:id="@+id/tvColorString"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:text="#FFFFFF"
                        android:layout_marginStart="@dimen/dp_12"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_20" />
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>