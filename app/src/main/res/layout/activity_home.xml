<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_52"
        android:layout_marginEnd="@dimen/dp_20"
        android:contentDescription="@string/settings"
        android:scaleType="fitXY"
        android:src="@drawable/ic_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgAppName"
        android:layout_width="@dimen/dp_274"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_112"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_home_logo_figma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_236"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/dp_68">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPlay"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_112"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_0"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_1_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_left" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv1"
                        android:layout_width="@dimen/dp_206"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="start|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/play"
                        android:textColor="@color/figma_primary"
                        android:textSize="@dimen/sp_28"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="@dimen/dp_2" />

                    <ImageView
                        android:layout_width="@dimen/dp_112"
                        android:layout_height="@dimen/dp_112"
                        android:layout_gravity="end"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_1_figma" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCosPlay"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_112"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_12"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_2_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_right" />

                    <ImageView
                        android:layout_width="@dimen/dp_112"
                        android:layout_height="@dimen/dp_112"
                        android:layout_gravity="start"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_2_figma" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv2"
                        android:layout_width="@dimen/dp_216"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="end|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/cosplay_therian"
                        android:textColor="@color/figma_primary"
                        android:textSize="@dimen/sp_28"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="@dimen/dp_2" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRandom"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_112"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_12"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCosPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_3_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_left" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv3"
                        android:layout_width="@dimen/dp_216"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="start|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/therian_random"
                        android:textColor="@color/figma_primary"
                        android:textSize="@dimen/sp_28"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="@dimen/dp_2" />

                    <ImageView
                        android:layout_width="@dimen/dp_102"
                        android:layout_height="@dimen/dp_112"
                        android:layout_gravity="end"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_3_figma" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMyCreation"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_112"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_12"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRandom"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_4_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_right" />

                    <ImageView
                        android:layout_width="@dimen/dp_112"
                        android:layout_height="@dimen/dp_112"
                        android:layout_gravity="start"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_4_figma" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv4"
                        android:layout_width="@dimen/dp_216"
                        android:layout_height="@dimen/dp_46"
                        android:layout_gravity="end|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/creation"
                        android:textColor="@color/figma_primary"
                        android:textSize="@dimen/sp_28"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="@dimen/dp_2" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
