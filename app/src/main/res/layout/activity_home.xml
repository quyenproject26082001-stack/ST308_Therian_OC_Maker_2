<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@string/settings"
        android:scaleType="fitXY"
        android:src="@drawable/ic_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgAppName"
        android:layout_width="274dp"
        android:layout_height="88dp"
        android:layout_marginTop="112dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_home_logo_figma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="236dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="68dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="0dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_1_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_left" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv1"
                        android:layout_width="206dp"
                        android:layout_height="46dp"
                        android:layout_gravity="start|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/play"
                        android:textColor="@color/figma_primary"
                        android:textSize="28sp"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="2dp" />

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="end"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_1_figma" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCosPlay"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_2_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_right" />

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="start"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_2_figma" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv2"
                        android:layout_width="216dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/cosplay_therian"
                        android:textColor="@color/figma_primary"
                        android:textSize="28sp"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="2dp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRandom"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCosPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_3_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_left" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv3"
                        android:layout_width="216dp"
                        android:layout_height="46dp"
                        android:layout_gravity="start|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/therian_random"
                        android:textColor="@color/figma_primary"
                        android:textSize="28sp"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="2dp" />

                    <ImageView
                        android:layout_width="102dp"
                        android:layout_height="112dp"
                        android:layout_gravity="end"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_3_figma" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMyCreation"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRandom"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_bg_4_figma" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_home_text_right" />

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="start"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_home_char_4_figma" />

                    <com.therian.oc.aaa.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv4"
                        android:layout_width="216dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|center_vertical"
                        android:fontFamily="@font/baloo_2_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/creation"
                        android:textColor="@color/figma_primary"
                        android:textSize="28sp"
                        app:outerStrokeColor="@color/white"
                        app:outerStrokeWidth="2dp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
